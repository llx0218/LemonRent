[Unit]
Description=LemonRent web API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=lemonrent
Group=lemonrent
WorkingDirectory=/var/www/LemonRent
EnvironmentFile=/etc/lemonrent/lemonrent.env
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=300M
ExecStart=/var/www/LemonRent/.venv/bin/uvicorn lemonrent.web.app:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips 127.0.0.1 --workers 1

[Install]
WantedBy=multi-user.target
